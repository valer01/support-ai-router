# Copy to .env (gitignored) — docker compose auto-loads it.

# Required for real LLM classification. Without it, every request falls
# back to the human-review queue with a clear "[LLM unavailable]" note.
ANTHROPIC_API_KEY=

# Optional overrides
# SUPPORTROUTER_CLAUDE_MODEL=claude-haiku-4-5-20251001
# SUPPORTROUTER_CLAUDE_TIMEOUT=30
# SUPPORTROUTER_CONFIDENCE_THRESHOLD=0.7

# Adapter mode per channel: "mock" (default, in-memory + JSONL log, no
# network) or "real" (live API — requires the creds below).
# SUPPORTROUTER_SLACK_MODE=mock
# SUPPORTROUTER_JIRA_MODE=mock

# Real Slack (only used when SUPPORTROUTER_SLACK_MODE=real)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# Real Jira (only used when SUPPORTROUTER_JIRA_MODE=real)
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# Session cookie signing secret — set explicitly in any persistent deployment
# SUPPORTROUTER_SESSION_SECRET=

# Default local admin username seeded on first run
# SUPPORTROUTER_SEED_USERNAME=support.admin
